{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Zolt",
  "theme": "mint",
  "colors": {
    "primary": "#1DB97C",
    "light": "#1DB97C",
    "dark": "#1DB97C"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Onboarding",
            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart",
              "getting-started/account-setup",
              "getting-started/workspace-overview",
              {
                "group": "Migration",
                "pages": [
                  "migration/introduction-migration"
                ]
              }
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "getting-started/key-concepts",
              "getting-started/roles-and-permissions",
              "getting-started/integrations-overview"
            ]
          }
        ]
      },
      {
        "tab": "Product Guides",
        "groups": [
          {
            "group": "Using the App",
            "pages": [
              "guides/dashboard",
              "guides/managing-projects",
              "guides/team-collaboration",
              "guides/notifications"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "guides/connecting-integrations",
              "guides/automation",
              "guides/data-export"
            ]
          },
          {
            "group": "Account & Settings",
            "pages": [
              "guides/profile-settings",
              "guides/billing",
              "guides/security"
            ]
          }
        ]
      },
      {
        "tab": "Developer Docs",
        "groups": [
          {
            "group": "Developer Overview",
            "pages": [
              "developers/introduction",
              "developers/authentication",
              "developers/rate-limits",
              "developers/errors"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "developers/webhooks/overview",
              "developers/webhooks/events",
              "developers/webhooks/security"
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              "developers/api/overview",
              "developers/api/resources",
              "developers/api/pagination",
              "developers/api/changelog"
            ]
          }
        ]
      },
      {
        "tab": "Support",
        "groups": [
          {
            "group": "Help Center",
            "pages": [
              "support/faq",
              "support/troubleshooting",
              "support/contact"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Télécharger Zolt",
      "href": "https://zolt.to"
    }
  },
  "logo": {
    "light": "/images/Logo.svg",
    "dark": "/images/Logo.svg",
    "href": "https://zolt.to"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 700
    },
    "body": {
      "family": "Nunito",
      "weight": 500
    }
  },
  "styling": {
    "eyebrows": "section",
    "latex": false
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Qu'est ce que tu recherches ?..."
  }
}
